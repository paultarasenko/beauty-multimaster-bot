BOT_TOKEN=
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/beauty_bot
# Начальный владелец мастера MASTER_ID: записывается в masters.owner_telegram_id при старте, только если там пусто.
# Права администратора определяются masters.owner_telegram_id, а не этой переменной.
ADMIN_TELEGRAM_ID=
MASTER_ID=1
TIMEZONE=Europe/Minsk
# SLOT_INTERVAL_MINUTES больше не используется (этап 8): интервал записи мастер задаёт в боте, «⚙️ Настройки»

# --- Режим запуска (этап 4) ---
# polling (по умолчанию): один бот из BOT_TOKEN, мастер из MASTER_ID — локальная разработка.
# webhook: мульти-бот, у каждого мастера свой бот в таблице master_bots (python -m app.cli add-bot ...).
RUN_MODE=polling
# Только для RUN_MODE=webhook и CLI:
# Публичный https-адрес сервиса (TLS/обратный прокси настраиваются снаружи): по нему CLI регистрирует webhook у Telegram.
PUBLIC_BASE_URL=
# Ключ шифрования токенов ботов в БД (Fernet). Без него webhook-режим и CLI не работают. Сгенерировать:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Храните ключ отдельно от дампов БД; потеряв ключ, токены придётся ввести заново (add-bot).
BOT_TOKEN_ENCRYPTION_KEY=
# Порт webhook-сервера внутри контейнера (его же публикует docker-compose.yml).
WEBHOOK_PORT=8080

# --- Хранилище FSM / диалогов (этап 7); все значения необязательны ---
# Redis нужен только для FSM (состояния диалогов), не как кэш или очередь. Адрес; в docker-compose задан redis://redis:6379/0.
# Пароль, если есть, указывается в адресе: redis://:пароль@host:6379/0 (в логи он не попадает).
# REDIS_URL=redis://localhost:6379/0
# Где хранить состояния: redis | memory. Не задано: webhook → redis, polling → memory (как раньше).
# memory в режиме webhook допустим, но диалоги теряются при перезапуске и не общие между процессами (предупреждение в логе).
# FSM_STORAGE=
# Сколько секунд живут состояние и данные диалога без обновлений (по умолчанию 259200 = 3 суток).
# FSM_STATE_TTL_SECONDS=259200

# --- Единый планировщик всех мастеров (этап 6); все значения необязательны ---
# Сколько мастеров обрабатывается одновременно (общий лимит; каждый держит до одного соединения с БД — не больше размера пула).
SCHEDULER_MAX_CONCURRENT_TENANTS=5
# Лимит отправки на ОДНОГО бота, сообщений в секунду (Telegram допускает около 30; у каждого мастера свой бот).
SCHEDULER_BOT_RATE_PER_SECOND=25
# Таймаут одной отправки в Telegram и предельное время обработки одного мастера за тик, секунд.
SCHEDULER_SEND_TIMEOUT_SECONDS=15
SCHEDULER_TENANT_TIMEOUT_SECONDS=120
# Сколько уведомлений мастера забирается за тик.
SCHEDULER_NOTIFICATION_BATCH_SIZE=100
# Через сколько секунд застрявшее в sending уведомление (процесс упал посреди отправки) возвращается в очередь.
# Держите значительно больше SCHEDULER_TENANT_TIMEOUT_SECONDS.
SCHEDULER_CLAIM_STALE_SECONDS=600
# Сколько секунд ждём завершения текущих отправок при остановке приложения.
SCHEDULER_SHUTDOWN_TIMEOUT_SECONDS=30

# --- Суперадмин-бот владельца сервиса (этап 9); необязательно ---
# Отдельный служебный бот (создайте у @BotFather): подключение мастеров и их ботов, сводка, журнал, уведомления о проблемах.
# Пусто — функция выключена, остальное работает как раньше. Токен храните как секрет, нигде его не публикуйте.
SUPERADMIN_BOT_TOKEN=
# Telegram id суперадминистраторов через запятую (например, 123456789,987654321). Остальным бот не отвечает.
# Если токен задан, а список пуст или некорректен — суперадмин-бот не запускается (причина в логе).
SUPERADMIN_TELEGRAM_IDS=
# Не чаще одного уведомления суперадмину об одном и том же событии за столько секунд (по умолчанию 3600).
# SUPERADMIN_ALERT_INTERVAL_SECONDS=3600
# Как часто (RUN_MODE=webhook) проверять ботов мастеров через getMe/getWebhookInfo, секунд (по умолчанию 600).
# SUPERADMIN_HEALTH_INTERVAL_SECONDS=600
# true — если проверка видит, что webhook бота мастера не установлен или указывает на другой адрес (например, после перезапуска
# временного туннеля), он переустанавливается сам, без кнопки «Перерегистрировать webhook». Включайте, только когда
# PUBLIC_BASE_URL этого экземпляра — единственный верный адрес для ботов (одна работающая копия сервиса). По умолчанию false.
# SUPERADMIN_WEBHOOK_AUTO_REFRESH=false

# --- Пробный период мастеров (этап 10); все значения необязательны ---
# Срок пробного периода по умолчанию, дней. ТОЛЬКО ПРЕДЛАГАЕТСЯ суперадмину при создании мастера (кнопка отмечена ⭐) и никогда не
# применяется сам. Пусто — «без срока». Окончание срока ничего не отключает: бот работает, пока суперадмин сам не нажмёт «Отключить».
TRIAL_DEFAULT_DAYS=
# Ежедневная сводка суперадмину о сроках (нужен суперадмин-бот): час отправки 0–23 и часовой пояс (пусто — как TIMEZONE проекта).
# Если в этот час сервис был выключен, сводка уйдёт при ближайшей проверке (раз в 10 минут) в тот же день.
# SUPERADMIN_DIGEST_HOUR=10
# SUPERADMIN_TIMEZONE=

# --- Адрес Bot API (этап 12B); только для нагрузочного стенда ---
# Пусто (по умолчанию) — настоящий https://api.telegram.org. Заданный адрес используют ВСЕ боты приложения (боты мастеров, суперадмин-бот,
# планировщик, CLI): запросы вместе с токенами уходят туда. Нужен лишь стенду tools/loadtest (поддельный Telegram), его задаёт
# docker-compose.loadtest.yml сам. В рабочем .env оставляйте пустым или не указывайте. Формат: http://хост:порт, без /bot... на конце.
# TELEGRAM_API_BASE=

# --- Пул БД и лимиты webhook (этап 12C); необязательно, значения по умолчанию подходят для одного экземпляра ---
# Расчёт «пул ≤ max_connections PostgreSQL минус запас ~10» — README, «Пул соединений БД».
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=15
# DB_POOL_TIMEOUT=30
# DB_POOL_RECYCLE=1800
# WEBHOOK_MAX_CONCURRENT_UPDATES=16
# WEBHOOK_BOT_MAX_CONCURRENCY=4
# WEBHOOK_QUEUE_TIMEOUT_SECONDS=20
# TELEGRAM_REQUEST_TIMEOUT_SECONDS=20

# =====================================================================================================================
# PRODUCTION (этап 12A): docker-compose.prod.yml. Подробности и порядок запуска — docs/OPERATIONS.md.
# Все значения ниже — ПРИМЕРЫ. Строки с «ЗАМЕНИТЬ» обязательно заменить; проверка: grep -n ЗАМЕНИТЬ .env (должно быть пусто).
# Файл .env — секрет: chmod 600 .env, не добавлять в git, хранить копию отдельно от сервера (вместе с BOT_TOKEN_ENCRYPTION_KEY).
# В боевом стеке RUN_MODE, WEBHOOK_PORT, PUBLIC_BASE_URL, DATABASE_URL и REDIS_URL задаются самим docker-compose.prod.yml
# (из PUBLIC_DOMAIN и POSTGRES_*) и значения этих же переменных выше игнорируются.
# =====================================================================================================================
# Домен сервиса БЕЗ https:// (DNS A-запись на IP сервера; порты 80 и 443 открыты). Caddy сам получит сертификат.
PUBLIC_DOMAIN=bot.ЗАМЕНИТЬ-example.com
# Пользователь и база PostgreSQL в боевом стеке. Пароль: ТОЛЬКО буквы и цифры (он подставляется в адрес подключения).
# Сгенерировать: openssl rand -hex 24
POSTGRES_USER=postgres
POSTGRES_DB=beauty_bot
POSTGRES_PASSWORD=ЗАМЕНИТЬ_на_случайные_буквы_и_цифры
# Ключ шифрования токенов ботов (Fernet): в боевом стеке обязателен. Сгенерировать без Python:
#   openssl rand -base64 32 | tr '+/' '-_'
# Потеряли ключ — токены ботов в базе не расшифровать (придётся подключить ботов заново). Копия хранится ОТДЕЛЬНО от дампов БД.
# Уже есть работающий ключ (webhook-режим использовался раньше) — оставьте его: новый ключ сделает сохранённые токены нечитаемыми.
# ↑ Ключ вписывается в строку BOT_TOKEN_ENCRYPTION_KEY= в разделе «Режим запуска» выше (одна строка, не дублировать).
